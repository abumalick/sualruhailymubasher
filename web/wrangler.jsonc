// The public web app: app/dist served as static assets, plus /privacy (app/public/privacy.html).
// Production serves sualruhailymubasher.com and redirects www to it; `--env preview` is workers.dev only.
{
  "name": "sualruhaily-web",
  "account_id": "9ab550becc556ce60d4250bfdc48224c",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "sualruhailymubasher.com", "custom_domain": true },
    { "pattern": "www.sualruhailymubasher.com", "custom_domain": true }
  ],
  "env": {
    "preview": {
      "name": "sualruhaily-web-preview",
      "workers_dev": true,
      "routes": []
    }
  }
}
