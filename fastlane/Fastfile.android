# Run from the repo root: `fastlane android <lane>`.
ANDROID_DIR = "app/android"
ANDROID_AAB = "app/android/app/build/outputs/bundle/release/app-release.aab"
ANDROID_APK = "app/android/app/build/outputs/apk/release/app-release.apk"
ANDROID_SECRETS = File.expand_path("~/.config/albadrmubasher")
ANDROID_SIGNING_VARS = %w[ALBADR_KEYSTORE ALBADR_KEYSTORE_PASSWORD ALBADR_KEY_ALIAS ALBADR_KEY_PASSWORD].freeze

platform :android do
  before_all do
    # fastlane garbles Arabic metadata unless the locale is UTF-8
    ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
    ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?
  end

  def signing_vars_in(env_file)
    return {} unless File.exist?(env_file)
    File.readlines(env_file, chomp: true).each_with_object({}) do |line, vars|
      key, value = line.sub(/\Aexport\s+/, "").split("=", 2)
      vars[key] = value.to_s.delete_prefix('"').delete_suffix('"') if ANDROID_SIGNING_VARS.include?(key)
    end
  end

  # build.gradle signs only when these are set; an unsigned bundle would be refused by Play
  private_lane :load_signing_env do
    env_file = ENV.fetch("ALBADR_SIGNING_ENV", File.join(ANDROID_SECRETS, "env"))
    signing_vars_in(env_file).each { |key, value| ENV[key] ||= value }
    missing = ANDROID_SIGNING_VARS.select { |k| ENV[k].to_s.empty? }
    UI.user_error!("Upload-key settings missing (#{missing.join(', ')}): see #{env_file}") unless missing.empty?
  end

  private_lane :check_google_services do
    path = File.expand_path("../#{ANDROID_DIR}/app/google-services.json", __dir__)
    UI.user_error!("#{path} is missing: push would silently stop working") unless File.exist?(path)
    packages = JSON.parse(File.read(path))["client"].map { |c| c.dig("client_info", "android_client_info", "package_name") }
    UI.user_error!("#{path} has no client for com.albadrmubasher.app") unless packages.include?("com.albadrmubasher.app")
  end

  # The release to promote is the one this checkout builds
  def android_version_code
    gradle = File.read(File.expand_path("../#{ANDROID_DIR}/app/build.gradle", __dir__))
    gradle[/versionCode\s+(\d+)/, 1] || UI.user_error!("versionCode not found in build.gradle")
  end

  desc "Build the web app, sync it into Android and build the signed release bundle"
  lane :build do
    load_signing_env
    check_google_services
    sh("cd .. && pnpm --filter app build && cd app && npx cap sync android")
    gradle(task: "bundle", build_type: "Release", project_dir: ANDROID_DIR)
  end

  # The sideload key replaces whatever is in ENV, so an upload key sourced in the shell can never sign the APK
  private_lane :load_github_apk_signing_env do
    env_file = ENV.fetch("ALBADR_GITHUB_APK_SIGNING_ENV", File.join(ANDROID_SECRETS, "obtainium-apk.env"))
    vars = signing_vars_in(env_file)
    missing = ANDROID_SIGNING_VARS.select { |k| vars[k].to_s.empty? }
    UI.user_error!("Sideload-key settings missing (#{missing.join(', ')}): see #{env_file}") unless missing.empty?
    vars.each { |key, value| ENV[key] = value }
  end

  desc "Build the APK signed with the sideload key and publish it as a GitHub release for Obtainium (abumalick/albadrmubasher)"
  lane :github_apk do
    load_github_apk_signing_env
    check_google_services
    sh("cd .. && pnpm --filter app build && cd app && npx cap sync android")
    gradle(task: "assemble", build_type: "Release", project_dir: ANDROID_DIR)
    sh("cd .. && node scripts/github-apk.mjs publish #{ANDROID_APK}")
  end

  desc "Check that the service-account key reaches the Play Console"
  lane :validate_credentials do
    validate_play_store_json_key(json_key: CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file))
  end

  desc "Upload the listing texts, icon, feature graphic and screenshots, without a release"
  lane :upload_metadata do
    upload_to_play_store(skip_upload_aab: true, skip_upload_apk: true, skip_upload_changelogs: true, sync_image_upload: true)
  end

  desc "Build and upload the bundle to internal testing with its changelogs; the listing goes up with a store release. status:draft while the app has never been published"
  lane :internal do |options|
    build
    upload_to_play_store(
      track: "internal",
      aab: ANDROID_AAB,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: options[:status] || "completed"
    )
  end

  desc "Promote the current internal-testing release to production (sent to review), then publish the sideload APK on GitHub. validate_only:true checks without sending; status:draft while the app has never been published"
  lane :production do |options|
    publish_apk = !(options[:validate_only] || options[:status] == "draft")
    # Fail before promoting when the GitHub release could not follow (key missing, tag taken, gh logged out)
    if publish_apk
      load_github_apk_signing_env
      sh("cd .. && node scripts/github-apk.mjs check")
    end
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: android_version_code,
      track_promote_release_status: options[:status] || "completed",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true, # the promoted release keeps the notes it was uploaded with
      sync_image_upload: true,
      validate_only: options[:validate_only] || false
    )
    # A draft or a check has released nothing; a failed publish is retried with `fastlane android github_apk`
    github_apk if publish_apk
  end
end
