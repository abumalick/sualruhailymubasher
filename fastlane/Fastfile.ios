require "open3"
require "fileutils"
require "json"

# Run from the repository root on macOS: `fastlane ios <lane>`.
IOS_FASTLANE_DIR = File.expand_path(FastlaneCore::FastlaneFolder.path)
IOS_ROOT = File.expand_path("..", IOS_FASTLANE_DIR)
IOS_APP = "#{IOS_ROOT}/app/ios/App"
IOS_PBXPROJ = "#{IOS_APP}/App.xcodeproj/project.pbxproj"
IOS_SECRETS = File.expand_path(ENV.fetch("SUALRUHAILY_SECRETS", "~/.config/sualruhailymubasher"))
IOS_TEAM_ID = "H8JDJQSJ7M"

def ios_plist_value(path, key)
  out, status = Open3.capture2("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", path)
  status.success? ? out.strip : nil
end

def ios_secret_env(name)
  path = "#{IOS_SECRETS}/#{name}"
  UI.user_error!("#{path} not found (see README, iOS release)") unless File.exist?(path)
  File.readlines(path, chomp: true).grep(/\A[A-Z_]+=/).to_h { |line| line.split("=", 2) }
end

def ios_bundle_id
  ids = File.read(IOS_PBXPROJ).scan(/PRODUCT_BUNDLE_IDENTIFIER = ([^;]+);/).flatten.uniq
  UI.user_error!("project.pbxproj has #{ids.length} bundle ids: #{ids.join(', ')}") unless ids.length == 1
  ids.first
end

def ios_marketing_version
  File.read(IOS_PBXPROJ)[/MARKETING_VERSION = ([^;]+);/, 1] || UI.user_error!("MARKETING_VERSION not found")
end

# ios.env holds APP_STORE_KEY_ID and APP_STORE_ISSUER_ID; the key sits beside it as AuthKey_<id>.p8
def ios_asc_key
  @ios_asc ||= begin
    env = ios_secret_env("ios.env")
    {
      key_id: env.fetch("APP_STORE_KEY_ID"),
      issuer_id: env.fetch("APP_STORE_ISSUER_ID"),
      key_filepath: "#{IOS_SECRETS}/AuthKey_#{env.fetch('APP_STORE_KEY_ID')}.p8"
    }
  end
end

def ios_api_key
  app_store_connect_api_key(**ios_asc_key)
end

# Each bundle id has its own Firebase iOS app, so its plist is kept as GoogleService-Info.<bundle id>.plist
def ios_install_google_service_plist
  source = "#{IOS_SECRETS}/GoogleService-Info.#{ios_bundle_id}.plist"
  UI.user_error!("#{source} not found: download it from the Firebase iOS app for #{ios_bundle_id}") unless File.exist?(source)
  target = "#{IOS_APP}/App/GoogleService-Info.plist"
  FileUtils.cp(source, target)
  found = ios_plist_value(target, "BUNDLE_ID")
  UI.user_error!("GoogleService-Info.plist is for #{found}, the project is #{ios_bundle_id}") unless found == ios_bundle_id
end

def ios_build_web_and_sync
  sh("cd #{IOS_ROOT} && pnpm install --frozen-lockfile && pnpm --filter app build && pnpm --filter app exec cap sync ios")
end

# Without aps-environment the app never gets an APNs token, and nothing else would catch it before a device does
def ios_verify_ipa(ipa, build_number)
  payload = "#{File.dirname(ipa)}/unzipped"
  FileUtils.rm_rf(payload)
  sh("unzip", "-q", ipa, "-d", payload)
  app = Dir["#{payload}/Payload/*.app"].first || UI.user_error!("no .app in #{ipa}")
  info = "#{app}/Info.plist"
  built = [ios_plist_value(info, "CFBundleIdentifier"), ios_plist_value(info, "CFBundleShortVersionString"), ios_plist_value(info, "CFBundleVersion")]
  expected = [ios_bundle_id, ios_marketing_version, build_number.to_s]
  UI.user_error!("IPA is #{built.join(' ')}, expected #{expected.join(' ')}") unless built == expected
  entitlements, = Open3.capture2e("codesign", "-d", "--entitlements", ":-", app)
  UI.user_error!("the IPA is not signed for production APNs:\n#{entitlements}") unless entitlements =~ %r{<key>aps-environment</key>\s*<string>production</string>}
  UI.success("IPA #{built.join(' ')} with aps-environment production")
end

# The archive is built unsigned, then signed ad hoc with AppRelease.entitlements: the export keeps the
# entitlements it finds in the archive, and an unsigned one has none (no aps-environment). The export
# re-signs with Apple's cloud-managed distribution certificate through the API key, so no signing
# identity is needed in the (SSH-locked) keychain.
def ios_build_store_ipa(build_number)
  # Xcode's IPA export calls /usr/bin/rsync through PATH; Homebrew's rsync 3.x rejects openrsync's flags
  shim = "#{IOS_ROOT}/.tmp/fastlane-bin"
  FileUtils.mkdir_p(shim)
  FileUtils.ln_sf("/usr/bin/rsync", "#{shim}/rsync")
  ENV["PATH"] = "#{shim}:#{ENV.fetch('PATH', '')}"

  build_dir = "#{IOS_ROOT}/.tmp/ios-build"
  archive = "#{build_dir}/App.xcarchive"
  FileUtils.rm_rf(build_dir)
  FileUtils.mkdir_p(build_dir)
  File.write("#{build_dir}/ExportOptions.plist", <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0"><dict>
      <key>method</key><string>app-store-connect</string>
      <key>destination</key><string>export</string>
      <key>signingStyle</key><string>automatic</string>
      <key>teamID</key><string>#{IOS_TEAM_ID}</string>
      <key>uploadSymbols</key><true/>
      <key>manageAppVersionAndBuildNumber</key><false/>
    </dict></plist>
  PLIST
  sh("xcodebuild", "-project", "#{IOS_APP}/App.xcodeproj", "-scheme", "App",
     "-configuration", "Release", "-destination", "generic/platform=iOS",
     "-archivePath", archive, "archive",
     "CURRENT_PROJECT_VERSION=#{build_number}", "DEVELOPMENT_TEAM=#{IOS_TEAM_ID}",
     "CODE_SIGNING_ALLOWED=NO", "CODE_SIGNING_REQUIRED=NO", "CODE_SIGN_IDENTITY=")
  sh("codesign", "--force", "--sign", "-", "--entitlements", "#{IOS_APP}/App/AppRelease.entitlements",
     "#{archive}/Products/Applications/App.app")
  sh("xcodebuild", "-exportArchive", "-archivePath", archive,
     "-exportOptionsPlist", "#{build_dir}/ExportOptions.plist", "-exportPath", build_dir,
     "-allowProvisioningUpdates",
     "-authenticationKeyPath", ios_asc_key[:key_filepath],
     "-authenticationKeyID", ios_asc_key[:key_id],
     "-authenticationKeyIssuerID", ios_asc_key[:issuer_id])
  ipa = Dir["#{build_dir}/*.ipa"].first || UI.user_error!("the export produced no IPA")
  ios_verify_ipa(ipa, build_number)
  ipa
end

# The reviewer contact (name, phone, email) stays out of git in review-contact.env; the notes are committed
def ios_app_review_information
  contact = ios_secret_env("review-contact.env")
  {
    first_name: contact.fetch("FIRST_NAME"),
    last_name: contact.fetch("LAST_NAME"),
    phone_number: contact.fetch("PHONE_NUMBER"),
    email_address: contact.fetch("EMAIL_ADDRESS"),
    demo_user: "",
    demo_password: "",
    notes: File.read("#{IOS_FASTLANE_DIR}/app-review-notes.txt").strip
  }
end

platform :ios do
  before_all do
    # fastlane garbles Arabic metadata unless the locale is UTF-8
    ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
    ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?
  end

  # build_number: Android's versionCode, so both platforms of one commit carry the same version and build
  # number. release.sh passes it: the Mac's copy has no app/android/.
  desc "Build a signed App Store IPA in .tmp/ios-build without uploading it. build_number: required"
  lane :build do |options|
    key = ios_api_key
    number = Integer(options[:build_number].to_s, exception: false) || UI.user_error!("build_number:<Android versionCode> is required")
    uploaded = latest_testflight_build_number(api_key: key, app_identifier: ios_bundle_id, version: ios_marketing_version, initial_build_number: 0)
    if uploaded == number
      UI.user_error!("Build #{number} of #{ios_marketing_version} is already on TestFlight: if it is this commit, tag release/testflight/#{ios_marketing_version} instead of rebuilding")
    elsif uploaded > number
      UI.user_error!("TestFlight already has build #{uploaded} of #{ios_marketing_version}, above #{number}: bump the version")
    end
    ios_install_google_service_plist
    ios_build_web_and_sync
    ios_build_store_ipa(number)
  end

  desc "Build and upload to TestFlight. changelog_file: the testers' notes, relative to the repo root"
  lane :beta do |options|
    changelog = options[:changelog_file] && File.read(File.expand_path(options[:changelog_file], IOS_ROOT))
    ipa = build(build_number: options[:build_number])
    upload_to_testflight(api_key: ios_api_key, ipa: ipa, changelog: changelog, skip_waiting_for_build_processing: true)
  end

  desc "Upload the listing, age rating, review notes and screenshots (no binary, no submission)"
  lane :metadata do
    deliver(
      api_key: ios_api_key,
      app_identifier: ios_bundle_id,
      app_version: ios_marketing_version,
      app_review_information: ios_app_review_information,
      skip_screenshots: Dir["#{IOS_FASTLANE_DIR}/screenshots/ios/*/*.png"].empty?
    )
  end

  # The app-privacy endpoint is not in the App Store Connect API: this lane logs in with the Apple ID
  # (FASTLANE_USER, then the password and a 2FA code when asked)
  desc "Publish the App Privacy answers from app_privacy_details.json (Apple ID login)"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: ios_bundle_id,
      team_id: IOS_TEAM_ID,
      json_path: "#{IOS_FASTLANE_DIR}/app_privacy_details.json"
    )
  end

  # Declaring third-party content (the Sheikh's recordings, books and broadcast) states that the owner
  # holds the rights to it, which the owner confirmed. Approval releases the version at once.
  desc "Submit the latest TestFlight build of the current version for App Review, released when approved"
  lane :submit do |options|
    # notes_dir: release.sh's What's New text, one file per App Store language, relative to the repo root
    notes = options[:notes_dir] && %w[ar-SA en-US].to_h { |l| [l, File.read(File.expand_path("#{options[:notes_dir]}/#{l}.txt", IOS_ROOT))] }
    # Without build_number, deliver waits for the newest build of app_version to finish processing
    deliver(
      api_key: ios_api_key,
      app_identifier: ios_bundle_id,
      app_version: ios_marketing_version,
      # deliver sets the release type only while uploading the listing, so the listing goes up again here
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: { content_rights_contains_third_party_content: true },
      **(notes ? { release_notes: notes } : {})
    )
  end

  desc "Print the latest TestFlight build number of the current version"
  lane :build_status do
    n = latest_testflight_build_number(api_key: ios_api_key, app_identifier: ios_bundle_id, version: ios_marketing_version, initial_build_number: 0)
    UI.important("LATEST_BUILD=#{n}")
  end

  # deliver no longer sets price or availability (Apple retired those attributes), so this lane calls
  # the appPriceSchedules and v2 appAvailabilities endpoints directly. Run it once, for the first release.
  desc "Make the app free and available in every territory (first release)"
  lane :store_setup do
    ios_api_key
    api = Spaceship::ConnectAPI.client.tunes_request_client
    app = Spaceship::ConnectAPI::App.find(ios_bundle_id) || UI.user_error!("no App Store Connect app for #{ios_bundle_id}")

    free = api.get("v1/apps/#{app.id}/appPricePoints", { "filter[territory]" => "USA", "limit" => 200 })
              .body["data"].find { |p| p["attributes"]["customerPrice"] == "0.0" } || UI.user_error!("no free price point")
    api.post("v1/appPriceSchedules", {
      data: { type: "appPriceSchedules", relationships: {
        app: { data: { type: "apps", id: app.id } },
        baseTerritory: { data: { type: "territories", id: "USA" } },
        manualPrices: { data: [{ type: "appPrices", id: "${free}" }] }
      } },
      included: [{ type: "appPrices", id: "${free}", attributes: { startDate: nil },
                   relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } } }]
    })
    UI.success("price: free")

    territories = api.get("v1/territories", { "limit" => 200 }).body["data"].map { |t| t["id"] }
    api.post("v2/appAvailabilities", {
      data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true }, relationships: {
        app: { data: { type: "apps", id: app.id } },
        territoryAvailabilities: { data: territories.map { |t| { type: "territoryAvailabilities", id: "${#{t}}" } } }
      } },
      included: territories.map do |t|
        { type: "territoryAvailabilities", id: "${#{t}}", attributes: { available: true },
          relationships: { territory: { data: { type: "territories", id: t } } } }
      end
    })
    UI.success("available in #{territories.length} territories and new ones")
  end
end
